# SignalStack Challenger Trading Agent Environment Configuration
PORT=8080
SIGNAL_SECRET=your_signal_secret_here
SIGNALSTACK_WEBHOOK_URL=https://app.signalstack.com/hook/YOUR_WEBHOOK_ID
SIGNALSTACK_API_KEY=
SIGNALSTACK_EXIT_ACTION=close

# Database Credentials
SQLITE_DB_PATH=/data/agent.db
NEON_DATABASE_URL=postgresql://user:password@ep-your-host.aws.neon.tech/neondb?sslmode=require

# Optional PocketBase Audit
POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
